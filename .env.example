# ---- Site ----
# Public base URL of the site. Read at build time for metadata, canonical
# URLs, sitemap and structured data — set it before `docker compose build`.
SITE_URL=https://hamelndigital.de

# Public contact address shown on the website and used as fallback sender.
# TODO: replace with the verified business address.
CONTACT_EMAIL=info@hamelndigital.de

# ---- Contact form (SMTP) ----
# If SMTP_HOST is unset, the form stays functional but cannot deliver mail —
# it will show an honest error and point visitors to CONTACT_EMAIL instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown in the From header. Defaults to "Website <CONTACT_EMAIL>".
SMTP_FROM=
# Inbox that receives contact requests. Defaults to CONTACT_EMAIL.
CONTACT_TO=

# Secret used to sign the contact form's anti-spam token.
# If unset, a random per-process secret is generated (tokens stop working
# after a restart — acceptable for a single container).
FORM_TOKEN_SECRET=
